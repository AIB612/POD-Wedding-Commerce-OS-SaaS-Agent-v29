#: includes/class-podai-chat-admin.php:389
msgid "Do you offer gift wrapping?\nYes, gift wrapping is free — add a note at checkout.\n\nCan I pick up my order?\nYes, in our Zurich shop Mon–Sat."
msgstr "Proposez-vous l'emballage cadeau ?\nOui, l'emballage cadeau est gratuit — ajoutez une note au paiement.\n\nPuis-je retirer ma commande ?\nOui, dans notre boutique de Zurich du lundi au samedi."

#: includes/class-podai-chat-admin.php:389
msgid "One question per block: first line = question, next lines = answer, blank line between blocks."
msgstr "Une question par bloc : première ligne = question, lignes suivantes = réponse, ligne vide entre les blocs."

