#: includes/class-podai-chat-admin.php:289
msgid "Disconnect"
msgstr "Disconnetti"

#: includes/class-podai-chat-admin.php:292
msgid "Connect your store to the Pod.AI service. Your site gets its own key; only public product data, your policies and settings are sent. Orders stay in WooCommerce and are only read when a shopper gives the order number and e-mail."
msgstr "Collega il negozio al servizio Pod.AI. Il sito riceve una chiave propria; vengono inviati solo dati pubblici dei prodotti, policy e impostazioni. Gli ordini restano in WooCommerce e vengono letti solo quando un cliente indica numero d'ordine ed e-mail."

#: includes/class-podai-chat-admin.php:296
msgid "Pod.AI service URL"
msgstr "URL del servizio Pod.AI"

#: includes/class-podai-chat-admin.php:297
msgid "Connect to Pod.AI"
msgstr "Connetti a Pod.AI"

