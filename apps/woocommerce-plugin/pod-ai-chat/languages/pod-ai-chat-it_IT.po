msgstr "Tempo di risposta (ore)"

#: includes/class-podai-chat-admin.php:361
msgid "Greeting"
msgstr "Saluto"

#: includes/class-podai-chat-admin.php:361
msgid "Hi! Ask me about products, shipping or your order."
msgstr "Ciao! Chiedimi di prodotti, spedizioni o del tuo ordine."

