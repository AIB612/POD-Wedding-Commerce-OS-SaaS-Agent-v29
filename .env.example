# ============================================================
# POD Wedding Commerce OS — environment variables
# Copy this file to .env. Never commit the real .env.
# ============================================================

NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production the server refuses to start while these are missing or still the example values.
APP_ENCRYPTION_KEY=CHANGE_ME_TO_32_BYTE_SECRET
ADMIN_API_KEY=change-me
DEFAULT_TENANT_ID=tenant_demo

# Keep runtime data (checkout orders, proofs, tasks, connected stores) across restarts.
# Leave empty for a pure in-memory demo that resets to the seed data on every start.
STORE_PERSIST_PATH=./var/runtime-state.json
# Comma-separated allowed origins for cross-origin API calls. Empty = allow all (development).
CORS_ORIGINS=
# Set to true (or a hop count) when running behind a reverse proxy / load balancer so rate limits see real client IPs.
TRUST_PROXY=
# Max invitation sites one IP may publish per hour.
INVITATION_PUBLISH_PER_HOUR=20

# ---------------- Persistent storage (Shopify tables; more to follow) ----------------
# mysql://user:pass@host:3306/dbname -> MySQL / MariaDB (e.g. cPanel). Empty -> SQLite file at SQLITE_PATH (sql.js, no native build).
DATABASE_URL=
SQLITE_PATH=./data/app.db
# DB_DRIVER=memory forces a non-persistent in-memory store (tests).
DB_DRIVER=
DB_POOL_SIZE=5

# ---------------- Shopify app "POD Wedding Studio" (Phase 1) ----------------
# Dev Dashboard / Partner -> Apps -> POD Wedding Studio -> Client credentials. Secret is server-only.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Public HTTPS base of this server. Redirect URL = APP_URL/api/shopify/app/callback,
# webhooks = APP_URL/api/shopify/app/webhooks, app URL = APP_URL/api/shopify/app/install
APP_URL=https://YOUR_DOMAIN
SHOPIFY_ADMIN_API_VERSION=2025-10
# true = request expiring offline tokens in the token exchange (stored with refresh token, refreshed automatically).
SHOPIFY_EXPIRING_OFFLINE_TOKENS=false

# ---------------- Shopify Partner / Multi-store OAuth (legacy connector) ----------------
# Shopify Dev Dashboard -> Apps -> your app -> Client credentials
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# 2026-10 is the latest stable Admin API version as of 2026-10-05.
SHOPIFY_API_VERSION=2026-10
# Shared by the new app and the legacy connector. Add write_shipping for the CarrierService.
SHOPIFY_SCOPES=write_products,read_orders,write_orders,write_fulfillments,read_fulfillments,write_merchant_managed_fulfillment_orders
# Must exactly match the callback configured in Shopify Partner/Dev Dashboard.
SHOPIFY_REDIRECT_URI=https://YOUR_DOMAIN/api/shopify/oauth/callback
# Optional single-store fallback for local development only. Multi-store production uses OAuth tokens stored per store.
SHOPIFY_DEV_STORE_DOMAIN=
SHOPIFY_DEV_ADMIN_TOKEN=

# ---------------- PayPal ----------------
# PayPal Developer Dashboard -> Apps & Credentials
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Storefront checkout derives its return/cancel URLs from PUBLIC_BASE_URL:
#   return → /api/payments/paypal/return (captures the payment, then shows /payment-success.html)
#   cancel → /payment-success.html?status=CANCELLED
# The two values below are only used by the legacy low-level /api/paypal/orders endpoint.
PAYPAL_RETURN_URL=https://YOUR_DOMAIN/payment-success.html
PAYPAL_CANCEL_URL=https://YOUR_DOMAIN/

# TWINT — direct merchant integration with TWINT AG (no PSP). Requires a TWINT merchant contract,
# a store + cash register in https://portal.twint.ch and the .p12 certificate issued there.
# The connector (server/connectors/twint.js) is a skeleton: until StartOrder/MonitorOrder are implemented
# the API answers twint_not_configured (missing keys) or twint_not_implemented; the storefront shows "TWINT coming soon".
TWINT_ENV=pat                       # pat (TWINT test environment) | production
TWINT_SERVICE_VERSION=8_5           # TWINTMerchantServiceV<version> (SDK ships WSDL v8.5 … v10)
TWINT_STORE_UUID=                   # Store UUID ("MerchantUuid") from the merchant portal
TWINT_CASH_REGISTER_ID=             # your own cash-register id, enrolled via EnrollCashRegister
TWINT_CERT_PATH=                    # absolute path to the merchant .p12 certificate (keep outside the repo)
TWINT_CERT_PASSWORD=                # password chosen when the certificate was ordered
# TWINT_ENDPOINT=                   # optional override of the SOAP endpoint URL

# ---------------- LLM / Agent ----------------
# Both the API key and the model name are required; without them the storefront agent uses its built-in demo answers.
LLM_PROVIDER=openai
LLM_TIMEOUT_MS=30000
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Agent write actions are staged for approval unless explicitly allowed.
AGENT_AUTO_EXECUTE_READS=true
AGENT_REQUIRE_APPROVAL_FOR_WRITES=true

# ---------------- RAG / Search ----------------
VECTOR_PROVIDER=memory
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
QDRANT_URL=
QDRANT_API_KEY=
WEAVIATE_URL=
WEAVIATE_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------------- Marketing APIs ----------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_ACCESS_TOKEN=
REDDIT_ADS_CLIENT_ID=
REDDIT_ADS_CLIENT_SECRET=
REDDIT_ADS_REFRESH_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=

# ---------------- AI commerce / discovery protocols ----------------
# UCP profile is served from /.well-known/ucp when enabled.
ENABLE_UCP=true
UCP_VERSION=2026-01-23
UCP_PUBLIC_KEY_URL=
# OpenAI ACP/catalog feed — onboarding can require partner approval.
ENABLE_OPENAI_ACP_FEED=true
OPENAI_ACP_FEED_SECRET=
# Shopify Global/Storefront Catalog MCP uses agent profile URL.
SHOPIFY_UCP_AGENT_PROFILE_URL=https://YOUR_DOMAIN/.well-known/ucp
ENABLE_A2A_AGENT_CARD=true
ENABLE_MCP_TOOL_ENDPOINT=true

# ---------------- Logistics ----------------
AFTERSHIP_API_KEY=
AFTERSHIP_WEBHOOK_SECRET=
AFTERSHIP_SHIPPING_API_KEY=
SHIPPO_API_KEY=
EASYPOST_API_KEY=
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=
# Ship-from address used for live carrier rates / tax estimates (can also be set per tenant in Admin → API)
SHIPPING_ORIGIN_COUNTRY=CH
SHIPPING_ORIGIN_POSTAL=4051
SHIPPING_ORIGIN_CITY=Basel
SHIPPING_ORIGIN_ADDRESS1=
TRACK17_API_KEY=
DHL_API_KEY=
DHL_ACCOUNT_NUMBER=
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=

# ---------------- Tax calculation ----------------
AVALARA_ACCOUNT_ID=
AVALARA_LICENSE_KEY=
AVALARA_COMPANY_CODE=
AVALARA_ENV=sandbox

# Timeout for every outbound provider API call (carrier, tax, Shopify, PayPal, LLM)
EXTERNAL_API_TIMEOUT_MS=10000
# Shopify carrier-rate callback answers within this budget, falling back to regional rules
CARRIER_CALLBACK_BUDGET_MS=4000

# ---------------- Supplier / procurement ----------------
# Comma-separated authorized supplier JSON/CSV feeds or your ERP endpoints.
SUPPLIER_FEED_URLS=
SUPPLIER_SYNC_INTERVAL_MINUTES=60
DEFAULT_DUTY_RATE=0
DEFAULT_PAYMENT_FEE_RATE=0.035
DEFAULT_FULFILLMENT_OVERHEAD=0

# ---------------- Storage / mail ----------------
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
EMAIL_PROVIDER=console
SENDGRID_API_KEY=
POSTMARK_SERVER_TOKEN=
FROM_EMAIL=no-reply@example.com

# ---------------- Database / cache (recommended production) ----------------
DATABASE_URL=postgresql://user:password@localhost:5432/pod_commerce
REDIS_URL=redis://localhost:6379

# ---------------- Additional commerce channels ----------------
WOOCOMMERCE_BASE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
MAGENTO_BASE_URL=
MAGENTO_ACCESS_TOKEN=

# ---------------- Omnichannel messaging ----------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Instagram/Facebook messaging reuse Meta app/system-user permissions above.
# TikTok Business Messaging reuses TikTok API for Business authorization above.

# ---------------- POD Studio ----------------
# Let merchants connect Shopify / WooCommerce directly from studio.html (official OAuth / wc-auth flows).
# Keep false until merchants are signed in; when false, connections are recorded as admin tasks.
STUDIO_PUBLIC_CONNECT=false
# Privacy: designs are stored encrypted (APP_ENCRYPTION_KEY) and deleted automatically after these periods
STUDIO_RETENTION_DAYS=30
STUDIO_QUOTE_RETENTION_DAYS=90

# v29 customer account / transactional e-mail flow
# SendGrid is preferred when both providers are configured; Postmark is the fallback.
ORDER_NOTIFICATION_EMAIL=
FROM_NAME=POD Studio

# ---------------- Quick login (passwordless) — see docs/quick-login.md ----------------
# Signs the short-lived OAuth state/nonce/PKCE cookie. REQUIRED in production (32+ random chars);
# without it both sign-in buttons show "not configured". Generate: openssl rand -hex 32
SESSION_SECRET=
# "Continue with Google" — Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to ${PUBLIC_BASE_URL}/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# "Continue with Shop" — Shopify admin → Sales channels → Headless → your storefront → Customer Account API settings
# Shop domain: the store's myshopify domain or its primary storefront domain (e.g. your-store.myshopify.com)
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# Only for a "Confidential" client type; leave empty for a "Public" client (PKCE only).
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
# Optional; defaults to ${PUBLIC_BASE_URL}/api/auth/shop/callback (must be https — Shopify rejects http/localhost)
SHOPIFY_CUSTOMER_ACCOUNT_REDIRECT_URI=
