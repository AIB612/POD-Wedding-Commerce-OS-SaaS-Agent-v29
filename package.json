{
  "name": "pod-wedding-commerce-os",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server/app.js",
    "start": "node server/app.js",
    "test": "node server/self-test.js",
    "admin:dev": "npm --prefix admin-app run dev",
    "admin:build": "npm --prefix admin-app run build",
    "admin:preview": "npm --prefix admin-app run preview",
    "test:flows": "node server/flow-test.js",
    "test:http": "node server/http-flow-test.js",
    "test:hardening": "node server/hardening-test.js",
    "test:all": "node server/self-test.js && node server/studio-test.js && node server/flow-test.js && node server/hardening-test.js && node server/checkout-test.js && node server/http-flow-test.js && node server/order-lookup-test.js && node server/storefront-pages-test.js",
    "build:studio-data": "node server/build-studio-data.js",
    "test:studio": "node server/studio-test.js",
    "mockups:generate": "python3 scripts/generate_mockups.py > /dev/null && node server/build-studio-data.js",
    "mockups:import": "python3 scripts/import_mockup.py",
    "scenes:build": "python3 scripts/build_scenes.py && node server/build-studio-data.js",
    "test:v29": "node server/v29-flow-test.js",
    "test:rsvp": "node server/rsvp-test.js",
    "test:themes": "node server/wedding-themes-test.js",
    "build:wedding-themes": "node src/wedding-themes/build.mjs",
    "test:checkout": "node server/checkout-test.js",
    "test:auth": "node server/auth-test.js",
    "test:account": "node server/account-test.js",
    "test:studio-buy": "node server/studio-buy-test.js",
    "test:promo": "node server/promo-test.js",
    "test:lookup": "node server/order-lookup-test.js",
    "test:pages": "node server/storefront-pages-test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  }
}
